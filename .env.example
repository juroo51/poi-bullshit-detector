# Copy to .env and edit.

# ---- POI suitability judge (local Ollama model — free, no API key) ----
# Requires a running Ollama with the model pulled:
#   ollama serve            # start the local server
#   ollama pull llama3.2    # download the model
# If Ollama is unreachable, /check transparently falls back to a heuristic.
ENABLE_LLM=true
LLM_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# ---- Coordinate validation bounds ----
LAT_MIN=-90
LAT_MAX=90
LON_MIN=-180
LON_MAX=180
