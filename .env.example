# Copy to .env and edit.

# ---- Data-sanity LLM judge (Claude Opus 4.8) ----
# If you don't have a key, set ENABLE_LLM_SANITY=false to run with
# deterministic rules only.
ENABLE_LLM_SANITY=true
ANTHROPIC_API_KEY=

# ---- Crowd Tester thresholds / profile ----
CROWD_P95_MS=300
CROWD_ERROR_RATE=0.01
CROWD_CONCURRENCY=50
CROWD_DURATION_S=10
CROWD_REQUEST_TIMEOUT_S=5

# ---- Coordinate sanity bounds ----
LAT_MIN=-90
LAT_MAX=90
LON_MIN=-180
LON_MAX=180
