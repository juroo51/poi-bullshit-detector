        "properties": {
          "distance_m": { "type": "number" },
          "duration_s": { "type": "number" },
          "geometry": {
            "type": "array",
            "items": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
